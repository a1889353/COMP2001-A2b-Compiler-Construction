== <main> ==
line  addr  opcode                argument
   1     0  MAKE_FUNCTION         <fn stops_for>
   1     1  DEFINE                stops_for (const)
   5     2  LOAD                  print
   5     3  LOAD                  stops_for
   5     4  CONST                 83.7[L]
   5     5  CONST                 50[L]
   5     6  CALL                  stops_for 2 args
   5     7  CALL                  print 1 arg
   5     8  POP
   5     9  HALT

== fn stops_for(fuel, cap) ==
line  addr  opcode                argument
   1     0  ENTER_SCOPE
   2     1  LOAD                  fuel
   2     2  LOAD                  cap
   2     3  LE
   2     4  JUMP_IF_FALSE         9
   2     5  ENTER_SCOPE
   2     6  CONST                 0
   2     7  RETURN
   2     8  EXIT_SCOPE
   3     9  LOAD                  ceil
   3    10  LOAD                  fuel
   3    11  LOAD                  cap
   3    12  DIV
   3    13  CALL                  ceil 1 arg
   3    14  CONST                 1
   3    15  SUB
   3    16  RETURN
   1    17  EXIT_SCOPE
   1    18  CONST                 nothing
   1    19  RETURN
